{
  "name": "agent-fleet",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check:dashboard": "cd dashboard && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "tsx src/cli.ts",
    "dev": "tsx src/dev.ts",
    "dev:dashboard": "vite dashboard",
    "dev:preview": "tsx src/dev-preview.ts",
    "build:dashboard": "vite build dashboard",
    "watch:dashboard": "vite build dashboard --watch",
    "models:refresh": "tsx scripts/refresh-cursor-models.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "fast-check": "^4.10.2",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "better-sqlite3": false,
    "esbuild": false,
    "fsevents": false
  },
  "overrides": {
    "minimatch@>=10 <11": "11.0.1"
  }
}
